{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests", ":semanticCommits"],
  "timezone": "Europe/London",
  "schedule": ["before 7am on monday"],
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Group and auto-merge patch and minor updates once CI is green",
      "matchUpdateTypes": ["patch", "minor", "digest", "pin"],
      "groupName": "weekly dependencies",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Go toolchain updates follow the same path",
      "matchDatasources": ["golang-version"],
      "rangeStrategy": "bump",
      "automerge": true
    },
    {
      "description": "Major updates need a human",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["major-update"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "automerge": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true
}
