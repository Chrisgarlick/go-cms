# Main Caddy config. The site block is generated by `cms caddy` into
# /etc/caddy/sites/cms.caddy; the active upstream line lives in
# /etc/caddy/cms-upstream.caddy and is rewritten by deploy.sh.
{
	email {$CMS_ACME_EMAIL}
	servers {
		trusted_proxies static private_ranges
	}
}

import /etc/caddy/sites/*.caddy
