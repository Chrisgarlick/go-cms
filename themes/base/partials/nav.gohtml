<nav aria-label="{{.Label}}">
  <ul class="menu">
    {{range .Items}}
    <li class="menu-item{{if .Active}} is-active{{end}}{{with .Class}} {{.}}{{end}}">
      {{if .URL}}<a href="{{.URL}}"{{if .Current}} aria-current="page"{{end}}{{with .Target}} target="{{.}}"{{end}}{{with .Rel}} rel="{{.}}"{{end}}>{{.Label}}</a>{{else}}<span>{{.Label}}</span>{{end}}
      {{if .Children}}<ul class="submenu">{{range .Children}}<li><a href="{{.URL}}"{{if .Current}} aria-current="page"{{end}}>{{.Label}}</a></li>{{end}}</ul>{{end}}
    </li>
    {{end}}
  </ul>
</nav>
