{{with .Pagination}}{{if gt .Pages 1}}
<nav class="pagination" aria-label="Pagination">
  {{if .PrevURL}}<a class="page-prev" href="{{.PrevURL}}" rel="prev">Newer</a>{{end}}
  <span class="page-count">Page {{.Page}} of {{.Pages}}</span>
  {{if .NextURL}}<a class="page-next" href="{{.NextURL}}" rel="next">Older</a>{{end}}
</nav>
{{end}}{{end}}
