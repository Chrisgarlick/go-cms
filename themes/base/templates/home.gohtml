{{define "main"}}
<div class="wrap">
  <header class="archive-header">
    <h1>{{.Site.Name}}</h1>
    {{with .Site.Tagline}}<p class="archive-description">{{.}}</p>{{end}}
  </header>
  {{if .Entries}}
  <div class="cards">{{range .Entries}}{{template "partials/entry-card" .}}{{end}}</div>
  {{template "partials/pagination" .}}
  {{else}}
  <p class="empty">Welcome. Nothing has been published yet.</p>
  {{end}}
</div>
{{end}}
