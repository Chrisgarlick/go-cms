{{define "main"}}
<div class="wrap">
  <header class="archive-header">
    <p class="archive-kicker">{{.Taxonomy.Label.Singular}}</p>
    <h1>{{.Term.Name}}</h1>
    {{with .Term.Description}}<p class="archive-description">{{.}}</p>{{end}}
  </header>
  {{if .Entries}}
  <div class="cards">{{range .Entries}}{{template "partials/entry-card" .}}{{end}}</div>
  {{template "partials/pagination" .}}
  {{else}}
  <p class="empty">Nothing published here yet.</p>
  {{end}}
</div>
{{end}}
