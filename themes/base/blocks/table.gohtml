<figure class="table-wrap">
  <table>
    {{with .Data.caption}}<caption>{{.}}</caption>{{end}}
    {{range $i, $r := .Data.rows}}
    <tr>{{range lines (str $r.cells)}}{{if and (eq $i 0) $.Data.header}}<th scope="col">{{inline .}}</th>{{else}}<td>{{inline .}}</td>{{end}}{{end}}</tr>
    {{end}}
  </table>
</figure>
