{{define "flash"}}
{{with .Flash}}<div class="kit-alert flash flash-ok" data-tone="good" role="status">{{template "icon" "check"}}<span>{{.}}</span></div>{{end}}
{{with .Error}}<div class="kit-alert flash flash-error" data-tone="bad" role="alert">{{template "icon" "alert"}}<span>{{.}}</span></div>{{end}}
{{end}}
