{{define "content"}}
<header class="page-head"><div><h1>Security</h1><p class="muted">Daily checks of configuration, accounts, the database and dependencies. This page reports problems; it never changes anything by itself.</p></div>
  {{if can .Session "security.manage"}}<form method="post" action="/admin/security/run"><input type="hidden" name="csrf" value="{{.CSRF}}"><button class="btn">{{template "icon" "refresh"}} Run checks now</button></form>{{end}}</header>
{{if .Data.Findings}}
<div class="findings">
{{range .Data.Findings}}
<article class="finding finding-{{.Severity}}">
  <header><span class="sev sev-{{.Severity}}">{{title .Severity}}</span><h2>{{.Title}}</h2></header>
  {{if $.Data.Full}}{{with .Detail}}<p class="muted">{{.}}</p>{{end}}{{end}}
  <p><strong>Fix:</strong> {{.Remediation}}</p>
  <footer class="muted">First seen {{ago .FirstSeen}}{{if .AckUntil}} · acknowledged until {{dateOnly (deref .AckUntil)}}: {{.AckReason}}{{end}}</footer>
  {{if and (can $.Session "security.manage") (not .AckUntil)}}
  <details class="ack"><summary>Acknowledge</summary>
    <form method="post" action="/admin/security/ack" class="row">
      <input type="hidden" name="csrf" value="{{$.CSRF}}"><input type="hidden" name="id" value="{{.ID}}">
      <label class="field grow"><span class="label">Reason</span><input name="reason" required placeholder="Why this is acceptable"></label>
      <label class="field"><span class="label">For</span><select name="days"><option value="30">30 days</option><option value="90">90 days</option><option value="0">Until fixed</option></select></label>
      <button class="btn btn-sm">Acknowledge</button></form></details>
  {{end}}
</article>
{{end}}
</div>
{{else}}
<div class="empty-state ok">{{template "icon" "shield"}}<h2>No open findings</h2><p class="muted">Checks run every day. You'll get an email if something serious comes up.</p></div>
{{end}}
{{end}}
