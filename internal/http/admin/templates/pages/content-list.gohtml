{{define "content"}}
{{$t := .Data.Type}}
<header class="page-head">
  <div><h1>{{$t.Label.Plural}}</h1><p class="muted">{{.Data.Total}} {{if eq .Data.Total 1}}entry{{else}}entries{{end}}</p></div>
  <form method="post" action="/admin/content/{{$t.Name}}/new" class="head-actions">
    <input type="hidden" name="csrf" value="{{.CSRF}}">
    <button class="btn btn-primary" type="submit">{{template "icon" "plus"}} New {{lower $t.Label.Singular}}</button>
  </form>
</header>
<div class="toolbar">
  <nav class="tabs" aria-label="Filter by status">
    <a class="tab{{if eq .Data.Status ""}} is-active{{end}}" href="{{withQuery .Data.Base "status" ""}}">All <span>{{index .Data.Counts "all"}}</span></a>
    <a class="tab{{if eq .Data.Status "published"}} is-active{{end}}" href="{{withQuery .Data.Base "status" "published"}}">Published <span>{{index .Data.Counts "published"}}</span></a>
    <a class="tab{{if eq .Data.Status "draft"}} is-active{{end}}" href="{{withQuery .Data.Base "status" "draft"}}">Drafts <span>{{index .Data.Counts "draft"}}</span></a>
    <a class="tab{{if eq .Data.Status "scheduled"}} is-active{{end}}" href="{{withQuery .Data.Base "status" "scheduled"}}">Scheduled <span>{{index .Data.Counts "scheduled"}}</span></a>
    <a class="tab{{if eq .Data.Status "trashed"}} is-active{{end}}" href="{{withQuery .Data.Base "status" "trashed"}}">Trash <span>{{index .Data.Counts "trashed"}}</span></a>
  </nav>
  <form class="search" role="search"><input type="hidden" name="status" value="{{.Data.Status}}">{{range .Data.Filters}}{{if .Active}}<input type="hidden" name="{{.Field.Name}}" value="{{.Active}}">{{end}}{{end}}
    <label class="visually-hidden" for="q">Search {{lower $t.Label.Plural}}</label>
    <input id="q" type="search" name="q" value="{{.Data.Query}}" placeholder="Search titles…"></form>
</div>
{{range .Data.Filters}}{{$f := .}}
<nav class="list-filter" aria-label="Filter by {{lower .Label}}"><span class="muted">{{.Label}}:</span>
  <a{{if not .Active}} class="is-active" aria-current="true"{{end}} href="{{withQuery $.Data.Base $f.Field.Name "" "page" ""}}">All</a>
  {{range .Field.Options}}<a{{if eq $f.Active .Value}} class="is-active" aria-current="true"{{end}} href="{{withQuery $.Data.Base $f.Field.Name .Value "page" ""}}">{{or .Label .Value}}</a>{{end}}
</nav>
{{end}}
{{if .Data.Rows}}
<div class="table-wrap">
<table class="table">
  <thead><tr>{{range .Data.Columns}}<th scope="col">{{if and (eq .Key "updated_at") (eq $.Data.Status "scheduled")}}Scheduled{{else}}{{.Label}}{{end}}</th>{{end}}<th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
  <tbody>
  {{range $row := .Data.Rows}}
  <tr>
    {{range $.Data.Columns}}{{if .Field}}<td>{{listCell $row .Field}}</td>
    {{else if eq .Key "title"}}<td class="cell-title"><a href="/admin/entries/{{$row.ID}}">{{or $row.DraftTitle "Untitled"}}</a>{{if $row.ParentID}}<span class="muted"> · child page</span>{{end}}{{if $.Data.Type.Pattern}}<span class="cell-sub">/{{$row.DraftSlug}}</span>{{end}}</td>
    {{else if eq .Key "status"}}<td>{{if and $row.PublishedVersion (ne (deref2 $row.PublishedVersion) $row.Version) (ne $row.Status "trashed")}}{{template "status" "pending"}}{{else}}{{template "status" $row.Status}}{{end}}</td>
    {{else if eq .Key "author"}}<td class="muted">{{$row.AuthorName}}</td>
    {{else if eq .Key "updated_at"}}<td class="muted">{{if $row.ScheduledAt}}{{date (deref $row.ScheduledAt)}}{{else}}{{ago $row.UpdatedAt}}{{end}}</td>
    {{else if eq .Key "published_at"}}<td class="muted">{{if $row.PublishedAt}}{{date (deref $row.PublishedAt)}}{{end}}</td>
    {{else if eq .Key "menu_order"}}<td class="muted">{{$row.MenuOrder}}</td>
    {{end}}{{end}}
    {{with $row}}
    <td class="cell-actions">
      {{if eq .Status "trashed"}}
      <form method="post" action="/admin/entries/{{.ID}}/restore"><input type="hidden" name="csrf" value="{{$.CSRF}}"><button class="btn btn-ghost btn-sm">Restore</button></form>
      <form method="post" action="/admin/entries/{{.ID}}/delete" data-confirm="Delete this entry permanently? This cannot be undone."><input type="hidden" name="csrf" value="{{$.CSRF}}"><button class="btn btn-ghost btn-sm btn-danger-text">Delete forever</button></form>
      {{else}}
      <a class="btn btn-ghost btn-sm" href="/admin/entries/{{.ID}}">Edit</a>
      {{end}}
    </td>{{end}}
  </tr>
  {{end}}
  </tbody>
</table>
</div>
{{template "pager" (dict "Page" .Data.Page "Pages" .Data.Pages "Base" .Data.Base)}}
{{else}}
<div class="empty-state">
  {{template "icon" (or $t.Icon "file")}}
  <h2>{{if .Data.Query}}No {{lower $t.Label.Plural}} match “{{.Data.Query}}”{{else if eq .Data.Status "trashed"}}The trash is empty{{else}}No {{lower $t.Label.Plural}} yet{{end}}</h2>
  {{if not .Data.Query}}<form method="post" action="/admin/content/{{$t.Name}}/new"><input type="hidden" name="csrf" value="{{.CSRF}}"><button class="btn btn-primary">{{template "icon" "plus"}} Create the first one</button></form>{{end}}
</div>
{{end}}
{{end}}
